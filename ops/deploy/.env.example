# AI Gateway 示範環境變數
# 複製為 .env 後可覆寫 docker-compose.yml 的預設值。
# 下列密碼僅供本機示範，請勿直接用於任何正式環境。

# MySQL root（僅供容器內初始化）
MYSQL_ROOT_PASSWORD=aigateway_demo_root

# Gateway 資料庫（aigateway）
DB_USER=aigateway_app
DB_PASSWORD=aigateway_demo_app

# ERP 資料庫（mydb）查詢帳號
MYDB_USER=aigateway_ro
MYDB_PASSWORD=aigateway_demo_ro

# LLM 供應商金鑰（Gemini 或 OpenAI 相容端點，二選一）
# 未設定時服務仍可啟動，但聊天/Agent/RAG 會回傳供應商錯誤。
GEMINI_API_KEY=
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_COMPAT_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# 供應商選擇：gemini 或 openai-compat
GATEWAY_PROVIDER=gemini
GATEWAY_FALLBACK_PROVIDERS=

# 限流（預設停用）
GATEWAY_RATE_LIMIT_ENABLED=false
GATEWAY_RATE_LIMIT_DAILY=500
GATEWAY_RATE_LIMIT_PER_MIN=30
